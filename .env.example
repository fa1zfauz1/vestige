# ─────────────────────────────────────────────
# Family Digital Archive - Environment Variables
# ─────────────────────────────────────────────

# Project
APP_NAME="Family Digital Archive"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Docker
COMPOSE_PROJECT_NAME=family-digital-archive
UID=1000
GID=1000

# PostgreSQL
POSTGRES_DB=family_archive
POSTGRES_USER=archive_user
POSTGRES_PASSWORD=secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
# Redis — note: Laravel treats the string "null" as null (no auth). Use a real
# password or leave empty and disable requirepass in docker-compose.
REDIS_PASSWORD=devredispassword
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=photos
MINIO_REGION=us-east-1
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Laravel
DB_CONNECTION=pgsql
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_HOST=${POSTGRES_HOST}
DB_PORT=${POSTGRES_PORT}

FILESYSTEM_DISK=minio

# Google OAuth — replace with your own Google Cloud OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# App
APP_ADMIN_EMAIL=
UPLOAD_MAX_SIZE=20
